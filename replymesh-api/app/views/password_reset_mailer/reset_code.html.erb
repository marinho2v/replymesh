<div style="margin:0;background:#f4f5f7;padding:32px 16px;font-family:Inter,Arial,sans-serif;color:#111827">
  <div style="max-width:590px;margin:auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:22px;overflow:hidden;box-shadow:0 18px 55px rgba(15,23,42,.08)">
    <div style="background:<%= @template[:primary_color] %>;color:#ffffff;padding:28px 30px">
      <% if @template[:logo_url].present? %>
        <img src="<%= @template[:logo_url] %>" alt="<%= @template[:brand_name] %>" style="display:block;max-height:38px;max-width:180px;margin:0 0 18px">
      <% else %>
        <div style="font-size:14px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#8ab4ff"><%= @template[:brand_name] %></div>
      <% end %>
      <h1 style="margin:12px 0 0;font-size:28px;line-height:1.15;letter-spacing:-.03em"><%= @template[:password_reset_title] %></h1>
    </div>
    <div style="padding:30px">
      <p style="margin:0 0 14px;font-size:16px;line-height:1.6">Olá, <strong><%= @request.user.name %></strong>.</p>
      <p style="margin:0 0 20px;font-size:16px;line-height:1.6"><%= @template[:password_reset_intro] %> <strong><%= @request.company.name %></strong>.</p>
      <div style="margin:26px 0;padding:22px;border-radius:16px;background:#f8fafc;border:1px solid #e5e7eb;text-align:center">
        <div style="font-size:13px;color:#6b7280;font-weight:700;text-transform:uppercase;letter-spacing:.08em">Código de recuperação</div>
        <div style="font-size:38px;font-weight:900;letter-spacing:10px;margin-top:10px;color:#0f172a"><%= @code %></div>
      </div>
      <p style="margin:0 0 12px;font-size:15px;line-height:1.6">Este código expira em <strong>15 minutos</strong>.</p>
      <p style="margin:0;color:#6b7280;font-size:14px;line-height:1.6">Se você não solicitou a troca de senha, ignore este e-mail com segurança.</p>
    </div>
    <div style="padding:20px 30px;border-top:1px solid #eef0f3;color:#6b7280;font-size:13px">
      <%= @template[:footer_text] %>
    </div>
  </div>
</div>
